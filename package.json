{
  "name": "@sciencejournal/protocol",
  "version": "0.1.0",
  "description": "Reference implementation of the sciencejournal.ai protocol: canonical JSON, claim IDs, bundle hashes, signed entries, and the append-only Merkle log, with the reference harness verifiers run.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src",
    "!src/**/*.test.ts"
  ],
  "homepage": "https://sciencejournal.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/omerliran/sciencejournal-protocol.git"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "conformance": "tsx conformance/generate.ts",
    "harness": "tsx src/harness/cli.ts",
    "monitor": "tsx src/monitor/cli.ts"
  },
  "dependencies": {
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@noble/post-quantum": "^0.7.1",
    "canonicalize": "^5.1.0",
    "mdast-util-from-markdown": "^2.0.3",
    "mdast-util-gfm": "^3.1.0",
    "mdast-util-math": "^3.0.0",
    "micromark-extension-gfm": "^3.0.0",
    "micromark-extension-math": "^3.1.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "katex": "^0.19.0"
  }
}
